{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroTransit labelled validation corpus",
  "type": "object",
  "required": ["corpus_version", "cases"],
  "properties": {
    "corpus_version": {"type": "string"},
    "cases": {"type": "array", "items": {"type": "object", "required": ["target_id", "label", "reference"], "properties": {
      "target_id": {"type": "string", "minLength": 1},
      "label": {"enum": ["planet", "false_positive", "quiet_star"]},
      "reference": {"type": "string", "minLength": 1},
      "sectors": {"type": "array", "items": {"type": "integer"}},
      "notes": {"type": "string"}
    }}}
  }
}
