"""AstroTransit Web Dashboard."""

from __future__ import annotations
import sys
from pathlib import Path

_project_root = Path(__file__).resolve().parent.parent
if str(_project_root) not in sys.path:
    sys.path.insert(0, str(_project_root))

import streamlit as st


@st.cache_data(show_spinner=False)
def load_parquet_cached(path_str: str):
    import pandas as pd
    return pd.read_parquet(Path(path_str))

@st.cache_data(show_spinner=False)
def load_json_cached(path_str: str):
    import json
    with open(Path(path_str), "r", encoding="utf-8") as f:
        return json.load(f)

@st.cache_data(show_spinner=False)
def list_json_candidates():
    roots = [Path("outputs/json"), Path("outputs_top10/json"), Path("outputs_wsl_mcmc/json")]
    files = []
    for root in roots:
        if root.exists():
            files.extend([f for f in root.glob("*.json") if f.name != "all_candidates.jsonl"])
    uniq = {}
    for f in files:
        uniq[f.name] = f
    return sorted(uniq.values(), key=lambda x: x.name)

@st.cache_data(show_spinner=False)
def find_candidate_images(source_id: str, sector: int):
    safe_id = source_id.replace(" ", "_").replace("/", "_")
    sector_str = f"S{sector:02d}"
    roots = [
        Path("outputs/figures"),
        Path("outputs_top10/figures"),
        Path("outputs_wsl_mcmc/figures"),
    ]
    images = []
    for root in roots:
        if root.exists():
            images.extend(sorted(root.glob(f"{safe_id}_{sector_str}_*.png")))
    uniq = {}
    for img in images:
        uniq[img.name] = img
    return list(sorted(uniq.values(), key=lambda p: p.name))


st.set_page_config(
    page_title="AstroTransit",
    page_icon="telescope",
    layout="wide",
    initial_sidebar_state="expanded",
)


def apply_custom_css():
    st.markdown("""
    <style>
    .stApp { background-color: #0d1117; }
    [data-testid="stSidebar"] { background-color: #161b22; }
    h1, h2, h3 { color: #e6edf3 !important; }
    .stButton > button { background-color: #238636; color: white; border: none; border-radius: 6px; }
    </style>
    """, unsafe_allow_html=True)


def page_home():
    st.title("AstroTransit")
    st.markdown("**TESS ve JWST verilerinden transit tespiti platformu**")
    st.divider()

    col1, col2, col3, col4 = st.columns(4)
    with col1:
        st.metric("Veri Kaynagi", "TESS + JWST")
    with col2:
        st.metric("Tespit", "BLS + TLS")
    with col3:
        st.metric("Modelleme", "MAP + PyMC")
    with col4:
        st.metric("Siniflandirma", "A/B/C/D/X")

    st.divider()
    st.subheader("Hizli Baslangic")
    st.code("""
from astrotransit.pipelines.orchestrator import AstroTransitOrchestrator

with AstroTransitOrchestrator() as orch:
    result = orch.run_single("TIC 261136679")
    """, language="python")

    st.subheader("Kategori Tanimlari")
    class_data = {
        "Sinif": ["A", "B", "C", "D", "X"],
        "Aciklama": [
            "Cok yuksek guvenilirlik. Bilimsel analiz icin hazir.",
            "Yuksek olasilikli aday. Ek dogrulama onerilir.",
            "Supheli. Elle incelenmelidir.",
            "Gurultulu veya dusuk kaliteli.",
            "Alisilamdik davranis. Ozel inceleme gerekir.",
        ],
        "Skor Araligi": [">=90", "75-90", "55-75", "<55", "Anomali"],
    }
    st.dataframe(class_data, use_container_width=True, hide_index=True)


def page_single_target():
    st.title("Tek Hedef Analizi")

    with st.sidebar:
        st.subheader("Analiz Ayarlari")
        target_input = st.text_input("TIC ID", value="TIC 261136679")
        sector_input = st.text_input("Sektorler (bos = tumu)", value="")
        force_map = st.checkbox("Sadece MAP", value=True)
        skip_viz = st.checkbox("Gorsel Atla", value=False)
        skip_catalog = st.checkbox("Katalog Atla", value=False)
        run_button = st.button("Analizi Baslat", type="primary", use_container_width=True)

    if run_button:
        sectors = None
        if sector_input.strip():
            try:
                sectors = [int(s.strip()) for s in sector_input.split(",")]
            except ValueError:
                st.error("Sektor numaralari gecersiz. Ornek: 14,15,16")
                return

        st.info(f"Analiz basliyor: **{target_input}**")
        progress_bar = st.progress(0, text="Pipeline baslatiliyor...")

        try:
            from astrotransit.pipelines.orchestrator import AstroTransitOrchestrator
            progress_bar.progress(10, text="Orkestrator baslatiliyor...")

            with AstroTransitOrchestrator(
                force_map=force_map,
                force_mcmc=not force_map,
                skip_visualization=skip_viz,
                skip_catalog=skip_catalog,
                log_level="WARNING",
            ) as orch:
                progress_bar.progress(20, text="Veri indiriliyor...")
                result = orch.run_single(target_input, sectors=sectors)

            progress_bar.progress(100, text="Tamamlandi!")
            st.divider()

            if result.success:
                st.success(f"Pipeline tamamlandi — {result.sectors_processed} sektor, {result.candidates_confirmed} onayli aday")
            else:
                st.error(f"Pipeline basarisiz: {result.error}")
                return

            col1, col2, col3, col4 = st.columns(4)
            with col1:
                st.metric("Sektor", result.sectors_processed)
            with col2:
                st.metric("Aday Sayisi", result.candidates_found)
            with col3:
                st.metric("Onayli", result.candidates_confirmed)
            with col4:
                if result.stellar_props and result.stellar_props.is_valid():
                    st.metric("Teff", f"{result.stellar_props.teff:.0f} K")

            st.subheader("Sektor Sonuclari")
            for sr in result.sector_results:
                label = f"Sektor {sr.sector}"
                if sr.quality:
                    label += f" — Sinif {sr.quality.score.candidate_class.value}"
                with st.expander(label):
                    if sr.candidate is not None:
                        st.json(sr.candidate.to_dict())
                    if sr.quality is not None:
                        score = sr.quality.score
                        c1, c2, c3 = st.columns(3)
                        with c1:
                            st.metric("Skor", f"{score.total_score:.0f}/100")
                        with c2:
                            st.metric("FPP", f"{sr.quality.vetting.false_positive_probability:.3f}")
                        with c3:
                            st.metric("SNR", f"{sr.quality.snr.snr_adopted:.2f}")
                    if sr.viz is not None and not skip_viz:
                        if sr.viz.summary_panel and Path(str(sr.viz.summary_panel)).exists():
                            st.image(str(sr.viz.summary_panel), use_container_width=True)

        except Exception as e:
            progress_bar.empty()
            st.error(f"Hata: {e}")
            st.exception(e)


def page_catalog_explorer():
    st.title("Katalog Gezgini")

    parquet_path = st.text_input(
        "Parquet Dosya Yolu",
        value="outputs/parquet/astrotransit_candidates.parquet",
    )

    path = Path(parquet_path)
    if not path.exists():
        st.warning(f"Dosya bulunamadi: `{parquet_path}`")
        if st.button("Demo Veri Olustur"):
            _create_demo_parquet(path)
            st.rerun()
        return

    import pandas as pd
    try:
        df = load_parquet_cached(str(path))
    except Exception as e:
        st.error(f"Parquet okuma hatasi: {e}")
        return

    st.info(f"**{len(df)}** kayit yuklendi")

    with st.sidebar:
        st.subheader("Filtreler")
        available_classes = sorted(df["candidate_class"].dropna().unique().tolist()) if "candidate_class" in df.columns else []
        selected_classes = st.multiselect("Sinif", options=available_classes, default=available_classes)

        if "snr_adopted" in df.columns:
            snr_max = float(df["snr_adopted"].max()) if len(df) > 0 else 100.0
            snr_range = st.slider("SNR Araligi", 0.0, snr_max, (0.0, snr_max))
        else:
            snr_range = (0.0, 100.0)

        if "total_score" in df.columns:
            score_range = st.slider("Skor Araligi", 0.0, 100.0, (0.0, 100.0))
        else:
            score_range = (0.0, 100.0)

        max_fpp = st.slider("Maks FPP", 0.0, 1.0, 1.0, 0.05) if "fpp" in df.columns else 1.0
        confirmed_only = st.checkbox("Sadece Onayli", value=False)
        exclude_fp = st.checkbox("FP Heric Tut", value=False)
        anomalous_only = st.checkbox("Sadece Anomali", value=False)

    mask = pd.Series([True] * len(df), index=df.index)
    if "candidate_class" in df.columns and selected_classes:
        mask &= df["candidate_class"].isin(selected_classes)
    if "snr_adopted" in df.columns:
        mask &= df["snr_adopted"].between(snr_range[0], snr_range[1])
    if "total_score" in df.columns:
        mask &= df["total_score"].between(score_range[0], score_range[1])
    if "fpp" in df.columns:
        mask &= df["fpp"] <= max_fpp
    if confirmed_only and "cascade_confirmed" in df.columns:
        mask &= df["cascade_confirmed"] == True
    if exclude_fp and "is_false_positive" in df.columns:
        mask &= df["is_false_positive"] == False
    if anomalous_only and "is_anomalous" in df.columns:
        mask &= df["is_anomalous"] == True

    df_filtered = df[mask].copy()
    st.metric("Filtrelenmis Kayit", len(df_filtered))

    if "candidate_class" in df_filtered.columns and len(df_filtered) > 0:
        st.subheader("Sinif Dagilimi")
        class_counts = df_filtered["candidate_class"].value_counts().to_dict()
        cols = st.columns(min(5, len(class_counts)))
        for i, (cls, count) in enumerate(sorted(class_counts.items())):
            with cols[i % len(cols)]:
                st.metric(f"Sinif {cls}", count)

    st.subheader("Aday Tablosu")
    display_cols = ["source_id", "sector", "period", "depth_ppm", "rp_rs",
                    "planet_radius_rearth", "snr_adopted", "total_score", "candidate_class", "fpp"]
    available_display = [c for c in display_cols if c in df_filtered.columns]

    if available_display:
        sort_col = "total_score" if "total_score" in available_display else available_display[0]
        st.dataframe(df_filtered[available_display].sort_values(sort_col, ascending=False),
                     use_container_width=True, height=500)
    else:
        st.dataframe(df_filtered, use_container_width=True, height=500)

    if "period" in df_filtered.columns and "planet_radius_rearth" in df_filtered.columns:
        st.subheader("Periyot - Yaricap Diyagrami")
        import plotly.express as px
        df_plot = df_filtered[(df_filtered["period"] > 0) & (df_filtered["planet_radius_rearth"] > 0)].copy()
        if len(df_plot) > 0:
            fig = px.scatter(
                df_plot, x="period", y="planet_radius_rearth",
                color="candidate_class" if "candidate_class" in df_plot.columns else None,
                size="snr_adopted" if "snr_adopted" in df_plot.columns else None,
                hover_data=["source_id", "sector", "total_score", "fpp"],
                log_x=True,
                labels={"period": "Periyot (gun)", "planet_radius_rearth": "Gezegen Yaricapi (R_earth)"},
                template="plotly_dark",
                color_discrete_map={"A": "#3fb950", "B": "#58a6ff", "C": "#f0883e", "D": "#8b949e", "X": "#bc8cff"},
            )
            fig.update_layout(paper_bgcolor="#0d1117", plot_bgcolor="#161b22", height=500)
            st.plotly_chart(fig, use_container_width=True)

    csv_data = df_filtered.to_csv(index=False)
    st.download_button(label="CSV Indir", data=csv_data, file_name="astrotransit_filtered.csv", mime="text/csv")


def page_candidate_detail():
    st.title("Aday Detayi")

    json_dir = Path("outputs/json")
    if not json_dir.exists():
        st.warning("JSON dizini bulunamadi. Once bir analiz calistirin.")
        return

    json_files = sorted([f for f in json_dir.glob("*.json") if f.name != "all_candidates.jsonl"])
    if not json_files:
        st.warning("Henuz JSON raporu yok.")
        return

    selected = st.selectbox("Aday Sec", options=json_files, format_func=lambda x: x.stem)

    if selected:
        try:
            data = load_json_cached(str(selected))
        except Exception as e:
            st.error(f"JSON okuma hatasi: {e}")
            return

        params = data.get("parameters", {})
        derived = data.get("derived", {})
        quality = data.get("quality", {})
        score_data = data.get("score", {})

        col1, col2, col3, col4 = st.columns(4)
        with col1:
            st.metric("Periyot", f"{params.get('period_days', 0):.5f} d")
        with col2:
            st.metric("Rp", f"{derived.get('planet_radius_rearth', 0):.2f} R_earth")
        with col3:
            st.metric("SNR", f"{quality.get('snr_adopted', 0):.2f}")
        with col4:
            cls = score_data.get("candidate_class", "?")
            scr = score_data.get("total_score", 0)
            st.metric(f"Sinif {cls}", f"{scr:.0f}/100")

        tabs = st.tabs(["Parametreler", "Yildiz", "Tespit", "Kalite", "Vetting", "Ham JSON"])

        with tabs[0]:
            st.json(params)
            st.json(derived)
        with tabs[1]:
            st.json(data.get("stellar", {}))
        with tabs[2]:
            st.json(data.get("detection", {}))
        with tabs[3]:
            st.json(quality)
            st.json(score_data)
        with tabs[4]:
            st.json(data.get("vetting", {}))
        with tabs[5]:
            st.json(data)

        st.subheader("Gorseller")
        source_id = data.get("target", {}).get("source_id", "")
        sector = data.get("target", {}).get("sector", 0)
        safe_id = source_id.replace(" ", "_").replace("/", "_")
        sector_str = f"S{sector:02d}"

        found_images = find_candidate_images(source_id, sector)

        if found_images:
            st.success(f"{len(found_images)} gorsel bulundu")

            image_order = {
                "summary": 1, "lightcurve": 2, "folded": 3,
                "bls_tls_comparison": 4, "bls_tls": 4,
                "residuals": 5, "timing": 6, "scorecard": 7,
            }
            found_images.sort(
                key=lambda p: next(
                    (v for k, v in image_order.items() if k in p.stem),
                    999,
                )
            )

            image_names = [img.stem for img in found_images]
            selected_idx = st.selectbox(
                "Gorsel sec",
                range(len(image_names)),
                format_func=lambda i: image_names[i],
            )
            if selected_idx is not None:
                st.image(str(found_images[selected_idx]), use_container_width=True)
                st.caption(f"Dosya: {found_images[selected_idx].name}")
        else:
            st.warning(f"{safe_id} S{sector:02d} icin gorsel bulunamadi.")
            st.info(
                "Aranan konumlar:\n"
                "- outputs/figures/\n"
                "- outputs_top10/figures/\n"
                "- outputs_wsl_mcmc/figures/"
            )


def page_settings():
    st.title("Ayarlar")
    config_path = Path("configs/default.toml")
    if config_path.exists():
        st.subheader("Mevcut Konfigurasyon")
        config_text = config_path.read_text(encoding="utf-8")
        st.code(config_text, language="toml")
        st.download_button(label="TOML Indir", data=config_text, file_name="default.toml", mime="text/plain")
    else:
        st.warning("Konfigurasyon dosyasi bulunamadi.")

    st.subheader("Sistem Bilgisi")
    try:
        from astrotransit.version import __version__
        st.info(f"AstroTransit v{__version__}")
    except ImportError:
        st.info("Versiyon bilgisi alinamadi.")

    import platform
    col1, col2 = st.columns(2)
    with col1:
        st.metric("Python", platform.python_version())
    with col2:
        st.metric("Platform", platform.system())


def _create_demo_parquet(path: Path) -> None:
    import pandas as pd
    import numpy as np
    path.parent.mkdir(parents=True, exist_ok=True)
    rng = np.random.default_rng(42)
    n = 25
    demo = pd.DataFrame({
        "source_id": [f"TIC {rng.integers(100000000, 999999999)}" for _ in range(n)],
        "sector": rng.integers(1, 60, n),
        "period": rng.uniform(0.5, 20, n),
        "depth_ppm": rng.uniform(50, 5000, n),
        "rp_rs": rng.uniform(0.01, 0.15, n),
        "planet_radius_rearth": rng.uniform(0.5, 15, n),
        "snr_adopted": rng.uniform(3, 40, n),
        "total_score": rng.uniform(10, 95, n),
        "candidate_class": rng.choice(["A", "B", "C", "D", "X"], n, p=[0.15, 0.25, 0.25, 0.25, 0.1]),
        "fpp": rng.uniform(0, 0.8, n),
        "cascade_confirmed": rng.choice([True, False], n, p=[0.5, 0.5]),
        "is_false_positive": rng.choice([True, False], n, p=[0.2, 0.8]),
        "is_anomalous": rng.choice([True, False], n, p=[0.1, 0.9]),
    })
    demo.to_parquet(path, index=False)
    st.success(f"Demo veri olusturuldu: {path}")


def main():
    apply_custom_css()

    with st.sidebar:
        st.title("AstroTransit")
        st.caption("Transit Tespiti ve Kategorizasyon")
        st.divider()

        page = st.radio(
            "Sayfa",
            options=["Ana Sayfa", "Tek Hedef", "Katalog Gezgini", "Aday Detayi", "Ayarlar"],
            label_visibility="collapsed",
        )

        st.divider()
        st.caption("v0.1.0")

    if page == "Ana Sayfa":
        page_home()
    elif page == "Tek Hedef":
        page_single_target()
    elif page == "Katalog Gezgini":
        page_catalog_explorer()
    elif page == "Aday Detayi":
        page_candidate_detail()
    elif page == "Ayarlar":
        page_settings()


if __name__ == "__main__":
    main()