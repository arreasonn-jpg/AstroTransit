.venv-validate/
.venv/
.venv-wsl/
.venv-test/

# Generated Python/cache files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build metadata (never commit packaging artifacts)
*.egg-info/
build/
dist/

# Runtime data and local credentials
/outputs*/
.cache/
*.log
.env

# Release artifacts and campaign run outputs.
# These are evidence packages / analysis products: keep them locally, publish
# them through GitHub Releases / Zenodo — never commit them to the source repo.
# Only small, human-auditable release metadata is versioned below.
/release/*
!/release/
!/release/README.md
!/release/manifests/
!/release/manifests/**
!/release/checksums/
!/release/checksums/**
!/release/release_notes/
!/release/release_notes/**
/campaign_runs/

# Backup/dump files are not a substitute for Git history.
**/*.backup
**/*.backup_*
**/*backup*
**/*.bak
**/*.orig

# One-off tooling dumps (project tree listings generated for LLM context etc.)
proje_yapisi*.txt
scripts_inventory*.txt
