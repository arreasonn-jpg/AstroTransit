"""
TLS (Transit Least Squares) doğrulama modülü.

Hippke & Heller (2019) metodolojisini temel alır.
transitleastsquares kütüphanesi kullanılır.

BLS'den temel farkı:
    - Dikdörtgen kutu yerine gerçekçi transit şeklini (limb darkening)
      kullanır.
    - Bu sayede SDE hesabı daha hassas ve daha az yanlış alarm üretir.
    - Daha yavaştır; bu yüzden sadece BLS adayları için çalıştırılır.

Pipeline'daki rolü:
    BLS aday ürettiyse → TLS ile periyot doğrulaması
    Her ikisi de onaylarsa → Modelleme aşamasına geç
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Optional

import numpy as np
from loguru import logger

try:
    from transitleastsquares import transitleastsquares, transit_mask
    _TLS_AVAILABLE = True
except ImportError:
    _TLS_AVAILABLE = False
    logger.warning(
        "transitleastsquares kütüphanesi bulunamadı. "
        "TLS doğrulama devre dışı: pip install transitleastsquares"
    )

from astrotransit.preprocessing.tess_detrend import DetrendedLightCurve
from astrotransit.detection.thresholds import TLSThresholds
from astrotransit.detection.bls_search import BLSPeak


# ──────────────────────────────────────
# Sonuç veri modelleri
# ──────────────────────────────────────
@dataclass
class TLSResult:
    """
    TLS doğrulama sonuçları.

    Attributes
    ----------
    target_id : str
        Hedef TIC ID.
    sector : int
        Sektör numarası.
    period : float
        TLS periyot tahmini (gün).
    period_err : float
        Periyot belirsizliği (gün).
    t0 : float
        İlk transit merkez zamanı (BTJD).
    duration : float
        Transit süresi (gün).
    depth : float
        Transit derinliği (göreli birim).
    rp_rs : float
        Yarıçap oranı Rp/Rs.
    sde : float
        Signal Detection Efficiency.
    snr : float
        Sinyal-gürültü oranı.
    odd_even_mismatch : float
        Tek-çift transit derinlik farkı (sigma cinsinden).
        Yüksek değer EB şüphesi işareti.
    transit_count : int
        Gözlenen transit sayısı.
    transit_times : np.ndarray
        Transit merkez zamanları dizisi.
    transit_depths : np.ndarray
        Bireysel transit derinlikleri.
    folded_phase : np.ndarray
        Faz katlanmış zaman dizisi.
    folded_flux : np.ndarray
        Faz katlanmış flux dizisi.
    model_phase : np.ndarray
        Model faz dizisi (görselleştirme için).
    model_flux : np.ndarray
        Model flux dizisi (görselleştirme için).
    passed_threshold : bool
        Eşikleri geçti mi?
    reject_reason : str
        Reddedilme sebebi.
    false_alarm_probability : float
        Yanlış alarm olasılığı.
    raw_stats : dict
        TLS çıktısından ham istatistikler.
    """

    target_id: str
    sector: int
    period: float
    period_err: float
    t0: float
    duration: float
    depth: float
    rp_rs: float
    sde: float
    snr: float
    odd_even_mismatch: float
    transit_count: int
    transit_times: np.ndarray
    transit_depths: np.ndarray
    folded_phase: np.ndarray
    folded_flux: np.ndarray
    model_phase: np.ndarray
    model_flux: np.ndarray
    passed_threshold: bool = True
    reject_reason: str = ""
    false_alarm_probability: float = 1.0
    raw_stats: dict = field(default_factory=dict)

    def to_dict(self) -> dict:
        """Serileştirilebilir sözlük."""
        return {
            "period": round(self.period, 6),
            "period_err": round(self.period_err, 6),
            "t0": round(self.t0, 6),
            "duration_hours": round(self.duration * 24, 4),
            "depth_ppm": round(self.depth * 1e6, 2),
            "rp_rs": round(self.rp_rs, 6),
            "sde": round(self.sde, 4),
            "snr": round(self.snr, 4),
            "odd_even_mismatch": round(self.odd_even_mismatch, 4),
            "transit_count": self.transit_count,
            "false_alarm_probability": round(self.false_alarm_probability, 6),
            "passed_threshold": self.passed_threshold,
            "reject_reason": self.reject_reason,
        }

    def summary(self) -> dict:
        """Özet sözlük."""
        return {
            "target_id": self.target_id,
            "sector": self.sector,
            **self.to_dict(),
        }


# ──────────────────────────────────────
# TLS doğrulama sınıfı
# ──────────────────────────────────────
class TLSSearch:
    """
    TLS transit doğrulama motoru.

    BLS'nin ürettiği aday periyot/t0 bilgisini alarak
    dar bir periyot penceresi içinde TLS ile yüksek
    çözünürlüklü arama yapar.

    Parameters
    ----------
    thresholds : TLSThresholds, opsiyonel
        Doğrulama eşik değerleri.
    oversampling_factor : int
        Frekans oversampling faktörü.
        Daha yüksek = daha hassas ama daha yavaş.
    use_stellar_params : bool
        Yıldız parametreleri (R, M) kullanılsın mı?
    transit_template : str
        Transit şablonu. "default", "grazing", "box".
    period_search_window : float
        BLS periyotu etrafında arama penceresi (göreli).
        Örn. 0.1 = BLS periyodunun ±%10'u.
    """

    def __init__(
        self,
        thresholds: Optional[TLSThresholds] = None,
        oversampling_factor: int = 3,
        use_stellar_params: bool = True,
        transit_template: str = "default",
        period_search_window: float = 0.1,
    ):
        if not _TLS_AVAILABLE:
            raise ImportError(
                "transitleastsquares gereklidir: "
                "pip install transitleastsquares"
            )

        self.thresholds = thresholds or TLSThresholds()
        self.oversampling_factor = oversampling_factor
        self.use_stellar_params = use_stellar_params
        self.transit_template = transit_template
        self.period_search_window = period_search_window

        self.thresholds.validate()

        logger.debug(
            f"TLSSearch — "
            f"min_sde: {self.thresholds.min_sde}, "
            f"oversampling: {oversampling_factor}, "
            f"template: {transit_template}, "
            f"pencere: ±{period_search_window * 100:.0f}%"
        )

    def _evaluate_threshold(self, result: TLSResult) -> TLSResult:
        """
        TLS sonucunun eşik değerlerini geçip geçmediğini kontrol eder.
        """

        reasons = []

        if result.sde < self.thresholds.min_sde:
            reasons.append(
                f"SDE={result.sde:.2f} < min={self.thresholds.min_sde}"
            )

        if result.snr < self.thresholds.min_snr:
            reasons.append(
                f"SNR={result.snr:.2f} < min={self.thresholds.min_snr}"
            )

        if result.transit_count < self.thresholds.min_transit_count:
            reasons.append(
                f"transit_count={result.transit_count} < "
                f"min={self.thresholds.min_transit_count}"
            )

        if result.odd_even_mismatch > self.thresholds.max_odd_even_mismatch:
            reasons.append(
                f"odd_even_mismatch={result.odd_even_mismatch:.2f} > "
                f"{self.thresholds.max_odd_even_mismatch} (EB şüphesi)"
            )

        if result.false_alarm_probability > self.thresholds.max_false_alarm:
            reasons.append(
                f"FAP={result.false_alarm_probability:.4f} > "
                f"max={self.thresholds.max_false_alarm}"
            )

        if reasons:
            result.passed_threshold = False
            result.reject_reason = " | ".join(reasons)
        else:
            result.passed_threshold = True
            result.reject_reason = ""

        return result

    def validate(
        self,
        detrended: DetrendedLightCurve,
        bls_peak: BLSPeak,
        stellar_radius: float = 1.0,
        stellar_mass: float = 1.0,
    ) -> TLSResult:
        """
        BLS adayını TLS ile doğrular.

        Parameters
        ----------
        detrended : DetrendedLightCurve
            Trend giderilmiş light curve.
        bls_peak : BLSPeak
            BLS'nin ürettiği aday tepe noktası.
        stellar_radius : float
            Yıldız yarıçapı (güneş yarıçapı cinsinden).
        stellar_mass : float
            Yıldız kütlesi (güneş kütlesi cinsinden).

        Returns
        -------
        TLSResult
            TLS doğrulama sonuçları.
        """

        target_id = detrended.target_id
        sector = detrended.sector

        logger.info(
            f"TLS doğrulama başlıyor — "
            f"{target_id} sektör {sector}: "
            f"BLS P={bls_peak.period:.4f}d"
        )

        time = detrended.time
        flux = detrended.flux
        flux_err = detrended.flux_err

        # ── Periyot arama penceresi ──
        period_min = bls_peak.period * (1.0 - self.period_search_window)
        period_max = bls_peak.period * (1.0 + self.period_search_window)

        # Sınırları makul aralıkta tut
        period_min = max(period_min, 0.1)
        period_max = min(period_max, (time[-1] - time[0]) / 2.0)

        logger.debug(
            f"TLS periyot penceresi: "
            f"[{period_min:.4f}, {period_max:.4f}] gün"
        )

        # ── TLS modelini oluştur ──
        tls_kwargs = {
            "use_threads": 1,
        }

        if self.use_stellar_params:
            r_star = float(stellar_radius)
            m_star = float(stellar_mass)
            tls_kwargs["R_star"] = r_star
            tls_kwargs["R_star_min"] = max(0.1, r_star * 0.5)
            tls_kwargs["R_star_max"] = r_star * 1.5
            tls_kwargs["M_star"] = m_star
            tls_kwargs["M_star_min"] = max(0.1, m_star * 0.5)
            tls_kwargs["M_star_max"] = m_star * 1.5

        try:
            model = transitleastsquares(time, flux, flux_err)

            tls_result = model.power(
                period_min=period_min,
                period_max=period_max,
                oversampling_factor=self.oversampling_factor,
                transit_template=self.transit_template,
                **tls_kwargs,
            )

        except Exception as e:
            logger.error(f"TLS çalıştırma hatası: {e}")
            return self._failed_result(target_id, sector, str(e))

        # ── Sonuçları çıkar ──
        try:
            period_val = float(tls_result.period)
            period_err_val = float(tls_result.period_uncertainty)
            t0_val = float(tls_result.T0)
            duration_val = float(tls_result.duration)
            depth_val = float(1.0 - tls_result.depth)
            rp_rs_val = float(tls_result.rp_rs) if hasattr(tls_result, 'rp_rs') else np.sqrt(depth_val)
            sde_val = float(tls_result.SDE)
            snr_val = float(tls_result.snr) if hasattr(tls_result, 'snr') else 0.0
            odd_even_val = float(tls_result.odd_even_mismatch)
            transit_count_val = int(tls_result.transit_count)
            fap_val = float(tls_result.FAP) if hasattr(tls_result, 'FAP') else 1.0

            # Dizi çıktıları
            transit_times = np.array(tls_result.transit_times)
            transit_depths = (
                np.array(tls_result.transit_depths)
                if hasattr(tls_result, 'transit_depths')
                else np.full(transit_count_val, depth_val)
            )
            folded_phase = np.array(tls_result.folded_phase)
            folded_flux = np.array(tls_result.folded_y)
            model_phase = np.array(tls_result.model_folded_phase)
            model_flux = np.array(tls_result.model_folded_model)

        except Exception as e:
            logger.error(f"TLS sonuç ayrıştırma hatası: {e}")
            return self._failed_result(target_id, sector, str(e))

        # ── Sonuç nesnesi ──
        result = TLSResult(
            target_id=target_id,
            sector=sector,
            period=period_val,
            period_err=period_err_val,
            t0=t0_val,
            duration=duration_val,
            depth=depth_val,
            rp_rs=rp_rs_val,
            sde=sde_val,
            snr=snr_val,
            odd_even_mismatch=odd_even_val,
            transit_count=transit_count_val,
            transit_times=transit_times,
            transit_depths=transit_depths,
            folded_phase=folded_phase,
            folded_flux=folded_flux,
            model_phase=model_phase,
            model_flux=model_flux,
            false_alarm_probability=fap_val,
            raw_stats={},
        )

        result = self._evaluate_threshold(result)

        if result.passed_threshold:
            logger.info(
                f"TLS doğrulama BAŞARILI — "
                f"{target_id} sektör {sector}: "
                f"P={period_val:.4f}d, "
                f"SDE={sde_val:.2f}, "
                f"SNR={snr_val:.2f}, "
                f"Rp/Rs={rp_rs_val:.4f}, "
                f"transit={transit_count_val}"
            )
        else:
            logger.info(
                f"TLS doğrulama BAŞARISIZ — "
                f"{target_id} sektör {sector}: "
                f"{result.reject_reason}"
            )

        return result

    def _failed_result(
        self,
        target_id: str,
        sector: int,
        reason: str,
    ) -> TLSResult:
        """Başarısız TLS sonucu döndürür."""

        return TLSResult(
            target_id=target_id,
            sector=sector,
            period=0.0,
            period_err=0.0,
            t0=0.0,
            duration=0.0,
            depth=0.0,
            rp_rs=0.0,
            sde=0.0,
            snr=0.0,
            odd_even_mismatch=999.0,
            transit_count=0,
            transit_times=np.array([]),
            transit_depths=np.array([]),
            folded_phase=np.array([]),
            folded_flux=np.array([]),
            model_phase=np.array([]),
            model_flux=np.array([]),
            passed_threshold=False,
            reject_reason=f"TLS hata: {reason}",
            false_alarm_probability=1.0,
        )