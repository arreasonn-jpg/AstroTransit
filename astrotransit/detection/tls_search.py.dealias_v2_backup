"""
TLS (Transit Least Squares) doğrulama modülü.

Hippke & Heller (2019) metodolojisini temel alır.
transitleastsquares kütüphanesi kullanılır.

BLS'den temel farkı:
    - Dikdörtgen kutu yerine gerçekçi transit şeklini (limb darkening)
      kullanır.
    - Bu sayede SDE hesabı daha hassas ve daha az yanlış alarm üretir.
    - Daha yavaştır; bu yüzden sadece BLS adayları için çalıştırılır.

Pipeline'daki rolü:
    BLS aday ürettiyse → TLS ile periyot doğrulaması
    Her ikisi de onaylarsa → Modelleme aşamasına geç
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Optional

import numpy as np
from loguru import logger

try:
    from transitleastsquares import transitleastsquares, transit_mask
    _TLS_AVAILABLE = True
except ImportError:
    _TLS_AVAILABLE = False
    logger.warning(
        "transitleastsquares kütüphanesi bulunamadı. "
        "TLS doğrulama devre dışı: pip install transitleastsquares"
    )

from astrotransit.preprocessing.tess_detrend import DetrendedLightCurve
from astrotransit.detection.thresholds import TLSThresholds
from astrotransit.detection.bls_search import BLSPeak


# ──────────────────────────────────────
# Sonuç veri modelleri
# ──────────────────────────────────────
@dataclass
class TLSResult:
    """
    TLS doğrulama sonuçları.

    Attributes
    ----------
    target_id : str
        Hedef TIC ID.
    sector : int
        Sektör numarası.
    period : float
        TLS periyot tahmini (gün).
    period_err : float
        Periyot belirsizliği (gün).
    t0 : float
        İlk transit merkez zamanı (BTJD).
    duration : float
        Transit süresi (gün).
    depth : float
        Transit derinliği (göreli birim).
    rp_rs : float
        Yarıçap oranı Rp/Rs.
    sde : float
        Signal Detection Efficiency.
    snr : float
        Sinyal-gürültü oranı.
    odd_even_mismatch : float
        Tek-çift transit derinlik farkı (sigma cinsinden).
        Yüksek değer EB şüphesi işareti.
    transit_count : int
        Gözlenen transit sayısı.
    transit_times : np.ndarray
        Transit merkez zamanları dizisi.
    transit_depths : np.ndarray
        Bireysel transit derinlikleri.
    folded_phase : np.ndarray
        Faz katlanmış zaman dizisi.
    folded_flux : np.ndarray
        Faz katlanmış flux dizisi.
    model_phase : np.ndarray
        Model faz dizisi (görselleştirme için).
    model_flux : np.ndarray
        Model flux dizisi (görselleştirme için).
    passed_threshold : bool
        Eşikleri geçti mi?
    reject_reason : str
        Reddedilme sebebi.
    false_alarm_probability : float
        Yanlış alarm olasılığı.
    raw_stats : dict
        TLS çıktısından ham istatistikler.
    """

    target_id: str
    sector: int
    period: float
    period_err: float
    t0: float
    duration: float
    depth: float
    rp_rs: float
    sde: float
    snr: float
    odd_even_mismatch: float
    transit_count: int
    transit_times: np.ndarray
    transit_depths: np.ndarray
    folded_phase: np.ndarray
    folded_flux: np.ndarray
    model_phase: np.ndarray
    model_flux: np.ndarray
    passed_threshold: bool = True
    reject_reason: str = ""
    false_alarm_probability: float = 1.0
    raw_stats: dict = field(default_factory=dict)

    def to_dict(self) -> dict:
        """Serileştirilebilir sözlük."""
        return {
            "period": round(self.period, 6),
            "period_err": round(self.period_err, 6),
            "t0": round(self.t0, 6),
            "duration_hours": round(self.duration * 24, 4),
            "depth_ppm": round(self.depth * 1e6, 2),
            "rp_rs": round(self.rp_rs, 6),
            "sde": round(self.sde, 4),
            "snr": round(self.snr, 4),
            "odd_even_mismatch": round(self.odd_even_mismatch, 4),
            "transit_count": self.transit_count,
            "false_alarm_probability": round(self.false_alarm_probability, 6),
            "passed_threshold": self.passed_threshold,
            "reject_reason": self.reject_reason,
        }

    def summary(self) -> dict:
        """Özet sözlük."""
        return {
            "target_id": self.target_id,
            "sector": self.sector,
            **self.to_dict(),
        }


# ──────────────────────────────────────
# TLS doğrulama sınıfı
# ──────────────────────────────────────
class TLSSearch:
    """
    TLS transit doğrulama motoru.

    BLS'nin ürettiği aday periyot/t0 bilgisini alarak
    dar bir periyot penceresi içinde TLS ile yüksek
    çözünürlüklü arama yapar.

    Parameters
    ----------
    thresholds : TLSThresholds, opsiyonel
        Doğrulama eşik değerleri.
    oversampling_factor : int
        Frekans oversampling faktörü.
        Daha yüksek = daha hassas ama daha yavaş.
    use_stellar_params : bool
        Yıldız parametreleri (R, M) kullanılsın mı?
    transit_template : str
        Transit şablonu. "default", "grazing", "box".
    period_search_window : float
        BLS periyotu etrafında arama penceresi (göreli).
        Örn. 0.1 = BLS periyodunun ±%10'u.
    """

    def __init__(
        self,
        thresholds: Optional[TLSThresholds] = None,
        oversampling_factor: int = 3,
        use_stellar_params: bool = True,
        transit_template: str = "default",
        period_search_window: float = 0.1,
    ):
        if not _TLS_AVAILABLE:
            raise ImportError(
                "transitleastsquares gereklidir: "
                "pip install transitleastsquares"
            )

        self.thresholds = thresholds or TLSThresholds()
        self.oversampling_factor = oversampling_factor
        self.use_stellar_params = use_stellar_params
        self.transit_template = transit_template
        self.period_search_window = period_search_window

        self.thresholds.validate()

        logger.debug(
            f"TLSSearch — "
            f"min_sde: {self.thresholds.min_sde}, "
            f"oversampling: {oversampling_factor}, "
            f"template: {transit_template}, "
            f"pencere: ±{period_search_window * 100:.0f}%"
        )

    def _evaluate_threshold(self, result: TLSResult) -> TLSResult:
        """
        TLS sonucunun eşik değerlerini geçip geçmediğini kontrol eder.
        """

        reasons = []

        if result.sde < self.thresholds.min_sde:
            reasons.append(
                f"SDE={result.sde:.2f} < min={self.thresholds.min_sde}"
            )

        if result.snr < self.thresholds.min_snr:
            reasons.append(
                f"SNR={result.snr:.2f} < min={self.thresholds.min_snr}"
            )

        if result.transit_count < self.thresholds.min_transit_count:
            reasons.append(
                f"transit_count={result.transit_count} < "
                f"min={self.thresholds.min_transit_count}"
            )

        if result.odd_even_mismatch > self.thresholds.max_odd_even_mismatch:
            reasons.append(
                f"odd_even_mismatch={result.odd_even_mismatch:.2f} > "
                f"{self.thresholds.max_odd_even_mismatch} (EB şüphesi)"
            )

        if result.false_alarm_probability > self.thresholds.max_false_alarm:
            reasons.append(
                f"FAP={result.false_alarm_probability:.4f} > "
                f"max={self.thresholds.max_false_alarm}"
            )

        if reasons:
            result.passed_threshold = False
            result.reject_reason = " | ".join(reasons)
        else:
            result.passed_threshold = True
            result.reject_reason = ""

        return result

    def validate(
        self,
        detrended: DetrendedLightCurve,
        bls_peak: BLSPeak,
        stellar_radius: float = 1.0,
        stellar_mass: float = 1.0,
    ) -> TLSResult:
        """
        BLS adayını TLS ile doğrular.

        Parameters
        ----------
        detrended : DetrendedLightCurve
            Trend giderilmiş light curve.
        bls_peak : BLSPeak
            BLS'nin ürettiği aday tepe noktası.
        stellar_radius : float
            Yıldız yarıçapı (güneş yarıçapı cinsinden).
        stellar_mass : float
            Yıldız kütlesi (güneş kütlesi cinsinden).

        Returns
        -------
        TLSResult
            TLS doğrulama sonuçları.
        """

        target_id = detrended.target_id
        sector = detrended.sector

        logger.info(
            f"TLS doğrulama başlıyor — "
            f"{target_id} sektör {sector}: "
            f"BLS P={bls_peak.period:.4f}d"
        )

        time = detrended.time
        flux = detrended.flux
        flux_err = detrended.flux_err

        # ── Periyot arama penceresi (güvenli) ──
        bls_p = bls_peak.period
        if bls_p <= 0:
            logger.error(f"BLS periyodu gecersiz: {bls_p}")
            return self._failed_result(target_id, sector, "invalid BLS period")

        period_min = bls_p * (1.0 - self.period_search_window)
        period_max = bls_p * (1.0 + self.period_search_window)

        # Sinirlari makul aralikta tut
        period_min = max(period_min, 0.1)

        # Gozlem penceresine gore period_max ust siniri
        obs_duration = float(time[-1] - time[0])
        max_by_obs = obs_duration / 2.0 if obs_duration > 0 else 100.0
        period_max = min(period_max, max_by_obs)

        # period_min >= period_max ise pencereyi geniş tut
        if period_min >= period_max:
            logger.warning(
                f"period_min ({period_min:.4f}) >= period_max ({period_max:.4f}). "
                f"BLS P={bls_p:.4f}, obs={obs_duration:.2f}d. Genis pencere kullanilacak."
            )
            period_min = max(0.1, bls_p * 0.5)
            period_max = min(max_by_obs, bls_p * 1.5)

            if period_min >= period_max:
                logger.error("Duzeltme sonrasi hala gecersiz. TLS atlanacak.")
                return self._failed_result(target_id, sector, "period range invalid")

        logger.debug(
            f"TLS periyot penceresi: "
            f"[{period_min:.4f}, {period_max:.4f}] gün"
        )

        # ── TLS modelini oluştur ──
        tls_kwargs = {
            "use_threads": 1,
        }

        if self.use_stellar_params:
            r_star = float(stellar_radius)
            m_star = float(stellar_mass)
            tls_kwargs["R_star"] = r_star
            tls_kwargs["R_star_min"] = max(0.1, r_star * 0.5)
            tls_kwargs["R_star_max"] = r_star * 1.5
            tls_kwargs["M_star"] = m_star
            tls_kwargs["M_star_min"] = max(0.1, m_star * 0.5)
            tls_kwargs["M_star_max"] = m_star * 1.5

        try:
            model = transitleastsquares(time, flux, flux_err)

            tls_result = model.power(
                period_min=period_min,
                period_max=period_max,
                oversampling_factor=self.oversampling_factor,
                transit_template=self.transit_template,
                **tls_kwargs,
            )

        except Exception as e:
            logger.error(f"TLS çalıştırma hatası: {e}")
            return self._failed_result(target_id, sector, str(e))

        # ── Sonuçları çıkar ──
        try:
            period_val = float(tls_result.period)
            period_err_val = float(tls_result.period_uncertainty)
            t0_val = float(tls_result.T0)
            duration_val = float(tls_result.duration)
            depth_val = float(1.0 - tls_result.depth)
            rp_rs_val = float(tls_result.rp_rs) if hasattr(tls_result, 'rp_rs') else np.sqrt(depth_val)
            sde_val = float(tls_result.SDE)
            snr_val = float(tls_result.snr) if hasattr(tls_result, 'snr') else 0.0
            odd_even_val = float(tls_result.odd_even_mismatch)
            transit_count_val = int(tls_result.transit_count)
            fap_val = float(tls_result.FAP) if hasattr(tls_result, 'FAP') else 1.0

            # Dizi çıktıları
            transit_times = np.array(tls_result.transit_times)
            transit_depths = (
                np.array(tls_result.transit_depths)
                if hasattr(tls_result, 'transit_depths')
                else np.full(transit_count_val, depth_val)
            )
            folded_phase = np.array(tls_result.folded_phase)
            folded_flux = np.array(tls_result.folded_y)
            model_phase = np.array(tls_result.model_folded_phase)
            model_flux = np.array(tls_result.model_folded_model)

        except Exception as e:
            logger.error(f"TLS sonuç ayrıştırma hatası: {e}")
            return self._failed_result(target_id, sector, str(e))

        # ── Sonuç nesnesi ──
        result = TLSResult(
            target_id=target_id,
            sector=sector,
            period=period_val,
            period_err=period_err_val,
            t0=t0_val,
            duration=duration_val,
            depth=depth_val,
            rp_rs=rp_rs_val,
            sde=sde_val,
            snr=snr_val,
            odd_even_mismatch=odd_even_val,
            transit_count=transit_count_val,
            transit_times=transit_times,
            transit_depths=transit_depths,
            folded_phase=folded_phase,
            folded_flux=folded_flux,
            model_phase=model_phase,
            model_flux=model_flux,
            false_alarm_probability=fap_val,
            raw_stats={},
        )

        result = self._evaluate_threshold(result)

        if result.passed_threshold:
            logger.info(
                f"TLS doğrulama BAŞARILI — "
                f"{target_id} sektör {sector}: "
                f"P={period_val:.4f}d, "
                f"SDE={sde_val:.2f}, "
                f"SNR={snr_val:.2f}, "
                f"Rp/Rs={rp_rs_val:.4f}, "
                f"transit={transit_count_val}"
            )
        else:
            logger.info(
                f"TLS doğrulama BAŞARISIZ — "
                f"{target_id} sektör {sector}: "
                f"{result.reject_reason}"
            )

        return result

    def validate_multimode(
        self,
        detrended,
        bls_peak,
        stellar_radius: float = 1.0,
        stellar_mass: float = 1.0,
    ):
        """
        TLS'yi 3 farkli modda calistir ve en iyi sonucu sec.

        Mod A: BLS yonlendirmeli dar arama (mevcut validate)
        Mod B: BLS harmoniklerinde arama (0.5x, 2x, 3x)
        Mod C: Bagimsiz genis tarama

        Her modun sonucu SDE ile karsilastirilir, en yuksek SDE secilir.
        Ayrica fiziksel gecerlilik kontrolu yapilir.
        """
        import numpy as np
        from dataclasses import replace

        target_id = detrended.target_id
        sector = detrended.sector

        results = []  # (mode_name, tls_result, adjusted_bls_peak)

        # ─── MOD A: BLS yonlendirmeli (mevcut davranis) ───
        try:
            r_a = self.validate(
                detrended, bls_peak, stellar_radius, stellar_mass
            )
            if r_a.passed_threshold or r_a.sde > 0:
                results.append(("A_direct", r_a, bls_peak))
                logger.info(
                    f"[Mod A] {target_id} S{sector}: "
                    f"P={r_a.period:.4f}d, SDE={r_a.sde:.2f}"
                )
        except Exception as e:
            logger.debug(f"Mod A hatasi: {e}")

        # ─── MOD B: BLS harmonikleri ───
        # BLS'in gercek periyodu harmonik olarak bulmus olabilir
        # 0.5x, 2x ve 3x etrafinda ayri ayri ara
        harmonic_factors = [0.5, 2.0, 3.0]

        # Mod B icin daha dar pencere (harmonik geri donmesin)
        original_window = self.period_search_window
        self.period_search_window = 0.03  # gecici %3 pencere

        for factor in harmonic_factors:
            harmonic_p = bls_peak.period * factor

            # Fiziksel makul araligi kontrol et
            if harmonic_p < 0.3 or harmonic_p > 30.0:
                continue

            # Yeni bir "sanki BLS peak" olustur
            fake_peak = replace(
                bls_peak,
                period=harmonic_p,
                period_err=bls_peak.period_err * factor,
            )

            try:
                r_h = self.validate(
                    detrended, fake_peak, stellar_radius, stellar_mass
                )
                if r_h.sde > 0:
                    results.append((f"B_harm_{factor}x", r_h, fake_peak))
                    logger.info(
                        f"[Mod B {factor}x] {target_id} S{sector}: "
                        f"P={r_h.period:.4f}d, SDE={r_h.sde:.2f}"
                    )
            except Exception as e:
                logger.debug(f"Mod B ({factor}x) hatasi: {e}")

        # Pencereyi orijinaline geri yukle
        self.period_search_window = original_window

        # ─── MOD C: Bagimsiz genis tarama ───
        try:
            from transitleastsquares import transitleastsquares as _tls

            time_arr = detrended.time
            flux_arr = detrended.flux
            err_arr = detrended.flux_err

            r_star = float(stellar_radius)
            m_star = float(stellar_mass)

            model = _tls(time_arr, flux_arr, err_arr)

            # Genis arama: 0.5d - 15d (veya gozlem/2)
            obs_duration = float(time_arr[-1] - time_arr[0])
            wide_max = min(15.0, obs_duration / 2.0)

            # Alt sinir: 0.3d (kucuk periyotlu gezegenler icin)
            tls_wide = model.power(
                period_min=0.3,
                period_max=wide_max,
                oversampling_factor=self.oversampling_factor,
                transit_template=self.transit_template,
                use_threads=1,
                R_star=r_star,
                R_star_min=max(0.1, r_star * 0.5),
                R_star_max=r_star * 1.5,
                M_star=m_star,
                M_star_min=max(0.1, m_star * 0.5),
                M_star_max=m_star * 1.5,
            )

            # Sonucu TLSResult formatinda topla
            wide_period = float(tls_wide.period)
            wide_sde = float(tls_wide.SDE)
            wide_snr = float(tls_wide.snr) if hasattr(tls_wide, 'snr') else 0.0

            # Yeni bir BLS peak olustur (sanki wide arama bulmus gibi)
            wide_peak = replace(
                bls_peak,
                period=wide_period,
                period_err=float(tls_wide.period_uncertainty),
            )

            # Mod C sonucunu DOGRUDAN kullan (validate cagirmadan)
            # Cunku validate BLS penceresine sikisir ve harmonige geri doner
            from astrotransit.detection.tls_search import TLSResult
            import numpy as np

            # Wide TLS ciktisindan TLSResult olustur
            try:
                depth_val = float(1.0 - tls_wide.depth)
                rp_rs_val = float(tls_wide.rp_rs) if hasattr(tls_wide, 'rp_rs') else float(np.sqrt(max(0, depth_val)))
                odd_even_val = float(tls_wide.odd_even_mismatch)
                transit_count_val = int(tls_wide.transit_count)
                fap_val = float(tls_wide.FAP) if hasattr(tls_wide, 'FAP') else 1.0

                transit_times_arr = np.array(tls_wide.transit_times) if hasattr(tls_wide, 'transit_times') else np.array([])
                transit_depths_arr = (
                    np.array(tls_wide.transit_depths)
                    if hasattr(tls_wide, 'transit_depths')
                    else np.full(transit_count_val, depth_val)
                )
                folded_phase_arr = np.array(tls_wide.folded_phase) if hasattr(tls_wide, 'folded_phase') else np.array([])
                folded_flux_arr = np.array(tls_wide.folded_y) if hasattr(tls_wide, 'folded_y') else np.array([])
                model_phase_arr = np.array(tls_wide.model_folded_phase) if hasattr(tls_wide, 'model_folded_phase') else np.array([])
                model_flux_arr = np.array(tls_wide.model_folded_model) if hasattr(tls_wide, 'model_folded_model') else np.array([])

                r_c = TLSResult(
                    target_id=target_id,
                    sector=sector,
                    period=wide_period,
                    period_err=float(tls_wide.period_uncertainty),
                    t0=float(tls_wide.T0),
                    duration=float(tls_wide.duration),
                    depth=depth_val,
                    rp_rs=rp_rs_val,
                    sde=wide_sde,
                    snr=wide_snr,
                    odd_even_mismatch=odd_even_val,
                    transit_count=transit_count_val,
                    transit_times=transit_times_arr,
                    transit_depths=transit_depths_arr,
                    folded_phase=folded_phase_arr,
                    folded_flux=folded_flux_arr,
                    model_phase=model_phase_arr,
                    model_flux=model_flux_arr,
                    false_alarm_probability=fap_val,
                    raw_stats={},
                )

                r_c = self._evaluate_threshold(r_c)

                if r_c.sde > 0:
                    results.append(("C_wide", r_c, wide_peak))
                    logger.info(
                        f"[Mod C wide] {target_id} S{sector}: "
                        f"P={r_c.period:.4f}d, SDE={r_c.sde:.2f}"
                    )
            except Exception as e:
                logger.debug(f"Mod C sonuc parse hatasi: {e}")
        except Exception as e:
            logger.debug(f"Mod C hatasi: {e}")

        # ─── EN IYI SONUCU SEC ───
        if not results:
            logger.warning(f"{target_id} S{sector}: hicbir TLS modu calismadi")
            return None, bls_peak

        # SDE'ye gore sirala, en yuksek uste
        results.sort(key=lambda x: x[1].sde, reverse=True)

        # Fiziksel gecerlilik onceligi:
        # Passing threshold + en yuksek SDE
        passing = [r for r in results if r[1].passed_threshold]

        if passing:
            best_mode, best_result, best_peak = passing[0]
        else:
            best_mode, best_result, best_peak = results[0]

        logger.info(
            f"[BEST] {target_id} S{sector}: {best_mode} secildi - "
            f"P={best_result.period:.4f}d, SDE={best_result.sde:.2f}"
        )

        # HARMONIK AYRISTIRMA (Dealiasing)
        # Bulunan periyot 2P harmonigi olabilir. Yarisini test et.
        dealiased = self._dealias_period(
            best_result, detrended, stellar_radius, stellar_mass
        )
        if dealiased is not None:
            logger.info(
                f"[DEALIAS] {target_id} S{sector}: "
                f"P={best_result.period:.4f}d -> P={dealiased.period:.4f}d "
                f"(fiziksel olarak daha tutarli)"
            )
            best_result = dealiased
            from dataclasses import replace
            best_peak = replace(best_peak, period=dealiased.period)

        return best_result, best_peak

    def _dealias_period(
        self,
        current_result,
        detrended,
        stellar_radius: float,
        stellar_mass: float,
    ):
        # Bulunan periyodun 2P harmonigi olup olmadigini kontrol et.
        # Duration/Period orani fiziksel olarak makul mu bak.
        # Eger cok kucukse, P/2 dogru periyot olabilir.
        import numpy as np
        from dataclasses import replace

        current_p = current_result.period
        current_dur = current_result.duration

        # Cok kisa periyotlarda dealiasing yapma
        if current_p < 0.6:
            return None

        # Duration/Period orani
        dp_ratio = current_dur / current_p if current_p > 0 else 0

        # Zaten normal ise dealiasing gereksiz
        # Sicak Jupiter: 0.04-0.10 arasi normaldir
        if dp_ratio > 0.03:
            return None

        # dp_ratio cok kucuk - 2P harmonigi supheli
        half_p = current_p / 2.0

        # Fiziksel makul araligi kontrol et
        if half_p < 0.3:
            return None

        logger.debug(
            f"Dealiasing test: current P={current_p:.4f}d "
            f"(dp_ratio={dp_ratio:.4f}), testing P/2={half_p:.4f}d"
        )

        # P/2 icin TLS dar pencere ile calistir
        try:
            from transitleastsquares import transitleastsquares as _tls

            time_arr = detrended.time
            flux_arr = detrended.flux
            err_arr = detrended.flux_err

            r_star = float(stellar_radius)
            m_star = float(stellar_mass)

            model = _tls(time_arr, flux_arr, err_arr)

            # P/2 civarinda %5 pencere
            p_min = half_p * 0.95
            p_max = half_p * 1.05

            tls_half = model.power(
                period_min=p_min,
                period_max=p_max,
                oversampling_factor=self.oversampling_factor,
                transit_template=self.transit_template,
                use_threads=1,
                R_star=r_star,
                R_star_min=max(0.1, r_star * 0.5),
                R_star_max=r_star * 1.5,
                M_star=m_star,
                M_star_min=max(0.1, m_star * 0.5),
                M_star_max=m_star * 1.5,
            )

            half_sde = float(tls_half.SDE)
            half_period = float(tls_half.period)
            half_duration = float(tls_half.duration)
            half_dp_ratio = half_duration / half_period if half_period > 0 else 0

            logger.debug(
                f"P/2 sonuc: P={half_period:.4f}d, "
                f"SDE={half_sde:.2f}, dp_ratio={half_dp_ratio:.4f}"
            )

            # KARAR: P/2 daha iyi mi?
            # 1. P/2 dp_ratio normal aralikta olmali (0.03-0.15)
            # 2. P/2 SDE mevcut SDE nin en az %60 i olmali
            half_ratio_ok = 0.03 <= half_dp_ratio <= 0.15
            sde_ok = half_sde >= current_result.sde * 0.60

            if half_ratio_ok and sde_ok:
                from astrotransit.detection.tls_search import TLSResult

                depth_val = float(1.0 - tls_half.depth)
                rp_rs_val = (
                    float(tls_half.rp_rs) if hasattr(tls_half, "rp_rs")
                    else float(np.sqrt(max(0, depth_val)))
                )

                new_result = TLSResult(
                    target_id=current_result.target_id,
                    sector=current_result.sector,
                    period=half_period,
                    period_err=float(tls_half.period_uncertainty),
                    t0=float(tls_half.T0),
                    duration=half_duration,
                    depth=depth_val,
                    rp_rs=rp_rs_val,
                    sde=half_sde,
                    snr=float(tls_half.snr) if hasattr(tls_half, "snr") else 0.0,
                    odd_even_mismatch=float(tls_half.odd_even_mismatch),
                    transit_count=int(tls_half.transit_count),
                    transit_times=np.array(tls_half.transit_times) if hasattr(tls_half, "transit_times") else np.array([]),
                    transit_depths=np.array(tls_half.transit_depths) if hasattr(tls_half, "transit_depths") else np.array([]),
                    folded_phase=np.array(tls_half.folded_phase) if hasattr(tls_half, "folded_phase") else np.array([]),
                    folded_flux=np.array(tls_half.folded_y) if hasattr(tls_half, "folded_y") else np.array([]),
                    model_phase=np.array(tls_half.model_folded_phase) if hasattr(tls_half, "model_folded_phase") else np.array([]),
                    model_flux=np.array(tls_half.model_folded_model) if hasattr(tls_half, "model_folded_model") else np.array([]),
                    false_alarm_probability=float(tls_half.FAP) if hasattr(tls_half, "FAP") else 1.0,
                    raw_stats={},
                )

                new_result = self._evaluate_threshold(new_result)
                return new_result

        except Exception as e:
            logger.debug(f"Dealiasing hatasi: {e}")

        return None

    def _failed_result(
        self,
        target_id: str,
        sector: int,
        reason: str,
    ) -> TLSResult:
        """Başarısız TLS sonucu döndürür."""

        return TLSResult(
            target_id=target_id,
            sector=sector,
            period=0.0,
            period_err=0.0,
            t0=0.0,
            duration=0.0,
            depth=0.0,
            rp_rs=0.0,
            sde=0.0,
            snr=0.0,
            odd_even_mismatch=999.0,
            transit_count=0,
            transit_times=np.array([]),
            transit_depths=np.array([]),
            folded_phase=np.array([]),
            folded_flux=np.array([]),
            model_phase=np.array([]),
            model_flux=np.array([]),
            passed_threshold=False,
            reject_reason=f"TLS hata: {reason}",
            false_alarm_probability=1.0,
        )