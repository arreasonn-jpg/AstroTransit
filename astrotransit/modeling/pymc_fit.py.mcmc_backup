"""
PyMC + exoplanet ile tam Bayesyen transit fit modülü.

Sadece güçlü adaylar için çalıştırılır (SNR > eşik).
NUTS örnekleyicisi ile tam posterior dağılımı elde edilir.

Gerekli kütüphaneler:
    pymc >= 5.0
    exoplanet >= 0.5
    arviz >= 0.15
    celerite2

Pipeline'daki rolü:
    MAP fit başarılı + SNR > mcmc_snr_threshold
    → PyMC posterior örnekleme
    → Parametre belirsizlikleri + korelasyonlar
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Optional

import numpy as np
from loguru import logger

try:
    import pymc as pm
    _PYMC_AVAILABLE = True
except ImportError:
    _PYMC_AVAILABLE = False
    logger.warning("pymc bulunamadı: pip install pymc")

try:
    import exoplanet as xo
    _EXOPLANET_AVAILABLE = True
except ImportError:
    _EXOPLANET_AVAILABLE = False
    logger.warning("exoplanet bulunamadı: pip install exoplanet")

try:
    import arviz as az
    _ARVIZ_AVAILABLE = True
except ImportError:
    _ARVIZ_AVAILABLE = False
    logger.warning("arviz bulunamadı: pip install arviz")

from astrotransit.preprocessing.tess_detrend import DetrendedLightCurve
from astrotransit.modeling.parameters import (
    TransitPriors,
    DerivedParameters,
    compute_derived_parameters,
)
from astrotransit.modeling.map_fit import MAPFitResult


# ──────────────────────────────────────
# Posterior özet veri modeli
# ──────────────────────────────────────
@dataclass
class PosteriorSummary:
    """
    Tek parametre için posterior özet istatistikleri.

    Attributes
    ----------
    name : str
        Parametre adı.
    mean : float
        Posterior ortalama.
    std : float
        Posterior standart sapma.
    median : float
        Posterior medyan.
    hdi_3 : float
        %94 HDI alt sınır.
    hdi_97 : float
        %94 HDI üst sınır.
    r_hat : float
        Gelman-Rubin istatistiği (1.0 = mükemmel yakınsama).
    ess : float
        Effective Sample Size.
    """

    name: str
    mean: float
    std: float
    median: float
    hdi_3: float
    hdi_97: float
    r_hat: float = 1.0
    ess: float = 0.0

    def to_dict(self) -> dict:
        return {
            "name": self.name,
            "mean": round(self.mean, 6),
            "std": round(self.std, 6),
            "median": round(self.median, 6),
            "hdi_3pct": round(self.hdi_3, 6),
            "hdi_97pct": round(self.hdi_97, 6),
            "r_hat": round(self.r_hat, 4),
            "ess": round(self.ess, 1),
        }


@dataclass
class MCMCFitResult:
    """
    PyMC MCMC fit sonuçları.

    Attributes
    ----------
    target_id : str
        Hedef TIC ID.
    sector : int
        Sektör numarası.
    success : bool
        MCMC başarılı tamamlandı mı?
    posteriors : dict[str, PosteriorSummary]
        Parametre adı → posterior özet.
    period : float
        Posterior medyan periyot.
    period_err : float
        Posterior standart sapma (periyot).
    t0 : float
        Posterior medyan t0.
    rp_rs : float
        Posterior medyan Rp/Rs.
    rp_rs_err : float
        Posterior standart sapma (Rp/Rs).
    impact_parameter : float
        Posterior medyan etki parametresi.
    inclination : float
        Posterior medyan eğim (derece).
    u1, u2 : float
        Posterior medyan limb darkening.
    log_likelihood : float
        Ortalama log-likelihood.
    r_hat_max : float
        Maksimum R-hat (yakınsama göstergesi).
    n_divergences : int
        NUTS ıraksama sayısı.
    n_samples : int
        Toplam geçerli örnek sayısı.
    derived : DerivedParameters
        Türetilmiş fiziksel parametreler.
    fit_method : str
        "mcmc".
    convergence_ok : bool
        R-hat < 1.1 mi?
    """

    target_id: str
    sector: int
    success: bool
    posteriors: dict[str, PosteriorSummary] = field(default_factory=dict)
    period: float = 0.0
    period_err: float = 0.0
    t0: float = 0.0
    rp_rs: float = 0.0
    rp_rs_err: float = 0.0
    impact_parameter: float = 0.0
    inclination: float = 90.0
    u1: float = 0.3
    u2: float = 0.2
    log_likelihood: float = -np.inf
    r_hat_max: float = 99.0
    n_divergences: int = 0
    n_samples: int = 0
    derived: DerivedParameters = field(default_factory=DerivedParameters)
    fit_method: str = "mcmc"
    convergence_ok: bool = False

    def to_dict(self) -> dict:
        base = {
            "target_id": self.target_id,
            "sector": self.sector,
            "fit_method": self.fit_method,
            "success": self.success,
            "convergence_ok": self.convergence_ok,
            "period": round(self.period, 6),
            "period_err": round(self.period_err, 6),
            "t0": round(self.t0, 6),
            "rp_rs": round(self.rp_rs, 6),
            "rp_rs_err": round(self.rp_rs_err, 6),
            "impact_parameter": round(self.impact_parameter, 4),
            "inclination_deg": round(self.inclination, 4),
            "u1": round(self.u1, 4),
            "u2": round(self.u2, 4),
            "log_likelihood": round(self.log_likelihood, 4),
            "r_hat_max": round(self.r_hat_max, 4),
            "n_divergences": self.n_divergences,
            "n_samples": self.n_samples,
            "posteriors": {
                k: v.to_dict() for k, v in self.posteriors.items()
            },
        }
        base.update(self.derived.to_dict())
        return base

    def summary(self) -> dict:
        return self.to_dict()


# ──────────────────────────────────────
# PyMC fit sınıfı
# ──────────────────────────────────────
class PyMCFitter:
    """
    PyMC + exoplanet ile tam Bayesyen transit fit.

    NUTS örnekleyicisi kullanarak posterior dağılımı örnekler.
    Sadece güçlü transit adaylarına uygulanır.

    Parameters
    ----------
    chains : int
        MCMC zincir sayısı.
    draws : int
        Zincir başına örnek sayısı (tune sonrası).
    tune : int
        Adaptasyon adım sayısı.
    target_accept : float
        NUTS hedef kabul oranı.
    random_seed : int
        Tekrarlanabilirlik için tohum.
    """

    def __init__(
        self,
        chains: int = 2,
        draws: int = 1500,
        tune: int = 1000,
        target_accept: float = 0.9,
        random_seed: int = 42,
    ):
        if not _PYMC_AVAILABLE:
            raise ImportError("pymc gereklidir: pip install pymc")
        if not _EXOPLANET_AVAILABLE:
            raise ImportError("exoplanet gereklidir: pip install exoplanet")

        self.chains = chains
        self.draws = draws
        self.tune = tune
        self.target_accept = target_accept
        self.random_seed = random_seed

        logger.debug(
            f"PyMCFitter — "
            f"chains: {chains}, draws: {draws}, "
            f"tune: {tune}, target_accept: {target_accept}"
        )

    def _extract_posterior_summary(
        self,
        idata,
        param_name: str,
    ) -> Optional[PosteriorSummary]:
        """
        arviz InferenceData'dan parametre posterior özetini çıkarır.

        Parameters
        ----------
        idata : arviz.InferenceData
            MCMC çıktısı.
        param_name : str
            Parametre adı.

        Returns
        -------
        PosteriorSummary veya None
        """

        if not _ARVIZ_AVAILABLE:
            return None

        try:
            summary = az.summary(
                idata,
                var_names=[param_name],
                hdi_prob=0.94,
            )

            if len(summary) == 0:
                return None

            row = summary.iloc[0]

            # Örnekleri doğrudan çek
            samples = idata.posterior[param_name].values.flatten()

            hdi = az.hdi(idata, var_names=[param_name], hdi_prob=0.94)
            hdi_vals = hdi[param_name].values

            return PosteriorSummary(
                name=param_name,
                mean=float(row["mean"]),
                std=float(row["sd"]),
                median=float(np.median(samples)),
                hdi_3=float(hdi_vals[0]),
                hdi_97=float(hdi_vals[1]),
                r_hat=float(row.get("r_hat", 1.0)),
                ess=float(row.get("ess_bulk", 0.0)),
            )

        except Exception as e:
            logger.debug(f"Posterior özet çıkarma hatası ({param_name}): {e}")
            return None

    def fit(
        self,
        detrended: DetrendedLightCurve,
        priors: TransitPriors,
        map_result: Optional[MAPFitResult] = None,
        stellar_radius: float = 1.0,
        stellar_mass: float = 1.0,
        stellar_teff: float = 5778.0,
    ) -> MCMCFitResult:
        """
        PyMC MCMC fit çalıştırır.

        MAP sonucu verilmişse başlangıç noktası olarak kullanılır.

        Parameters
        ----------
        detrended : DetrendedLightCurve
            Detrend edilmiş light curve.
        priors : TransitPriors
            Prior değerleri.
        map_result : MAPFitResult, opsiyonel
            MAP fit sonucu (başlangıç noktası için).
        stellar_radius : float
            Yıldız yarıçapı (R_sun).
        stellar_mass : float
            Yıldız kütlesi (M_sun).
        stellar_teff : float
            Yıldız efektif sıcaklığı (K).

        Returns
        -------
        MCMCFitResult
            MCMC posterior sonuçları.
        """

        target_id = detrended.target_id
        sector = detrended.sector

        logger.info(
            f"PyMC MCMC fit başlıyor — "
            f"{target_id} sektör {sector}: "
            f"P≈{priors.period:.4f}d, "
            f"{self.chains} zincir × {self.draws} örnek"
        )

        time = detrended.time
        flux = detrended.flux
        flux_err = detrended.flux_err

        # MAP sonucundan başlangıç değerleri
        if map_result is not None and map_result.success:
            init_period = map_result.period
            init_t0 = map_result.t0
            init_rp_rs = map_result.rp_rs
            init_b = map_result.impact_parameter
            init_u1 = map_result.u1
            init_u2 = map_result.u2
        else:
            init_period = priors.period
            init_t0 = priors.t0
            init_rp_rs = priors.rp_rs
            init_b = priors.impact_parameter
            init_u1 = priors.u1
            init_u2 = priors.u2

        try:
            with pm.Model() as model:

                # ── Priorlar ──

                # Periyot: Uniform
                log_period = pm.Uniform(
                    "log_period",
                    lower=np.log(priors.period_bounds[0]),
                    upper=np.log(priors.period_bounds[1]),
                    initval=np.log(init_period),
                )
                period = pm.Deterministic("period", pm.math.exp(log_period))

                # t0: Uniform
                t0 = pm.Uniform(
                    "t0",
                    lower=priors.t0_bounds[0],
                    upper=priors.t0_bounds[1],
                    initval=init_t0,
                )

                # Yarıçap oranı: log-Uniform
                log_rp_rs = pm.Uniform(
                    "log_rp_rs",
                    lower=np.log(priors.rp_rs_bounds[0]),
                    upper=np.log(priors.rp_rs_bounds[1]),
                    initval=np.log(init_rp_rs),
                )
                rp_rs = pm.Deterministic("rp_rs", pm.math.exp(log_rp_rs))

                # Etki parametresi: Uniform
                b = pm.Uniform(
                    "impact_parameter",
                    lower=0.0,
                    upper=1.2,
                    initval=init_b,
                )

                # Limb darkening: Kipping (2013) quadratic parametrizasyonu
                # q1, q2 → u1, u2 dönüşümü ile fiziksel geçerliliği zorla
                q1 = pm.Uniform("q1", lower=0.0, upper=1.0, initval=0.5)
                q2 = pm.Uniform("q2", lower=0.0, upper=1.0, initval=0.5)

                # Kipping (2013) dönüşümü
                u1 = pm.Deterministic("u1", 2 * pm.math.sqrt(q1) * q2)
                u2 = pm.Deterministic("u2", pm.math.sqrt(q1) * (1 - 2 * q2))

                # Jitter
                log_jitter = pm.Uniform(
                    "log_jitter",
                    lower=-15.0,
                    upper=0.0,
                    initval=-7.0,
                )

                # Baseline
                baseline = pm.Normal(
                    "baseline",
                    mu=1.0,
                    sigma=0.01,
                    initval=1.0,
                )

                # ── exoplanet orbit ──
                orbit = xo.orbits.KeplerianOrbit(
                    period=period,
                    t0=t0,
                    b=b,
                    r_star=stellar_radius,
                    m_star=stellar_mass,
                )

                # ── Transit ışık eğrisi ──
                light_curves = xo.LimbDarkLightCurve(u1, u2).get_light_curve(
                    orbit=orbit,
                    r=rp_rs * stellar_radius,
                    t=time,
                )
                model_flux_pm = pm.math.sum(light_curves, axis=-1) + baseline

                # ── Likelihood ──
                jitter_val = pm.math.exp(log_jitter)
                sigma_total = pm.math.sqrt(flux_err ** 2 + jitter_val ** 2)

                pm.Normal(
                    "obs",
                    mu=model_flux_pm,
                    sigma=sigma_total,
                    observed=flux,
                )

                # ── NUTS örnekleme ──
                logger.info("NUTS örnekleme başlıyor...")

                idata = pm.sample(
                    draws=self.draws,
                    tune=self.tune,
                    chains=self.chains,
                    target_accept=self.target_accept,
                    random_seed=self.random_seed,
                    progressbar=False,
                    return_inferencedata=True,
                )

        except Exception as e:
            logger.error(f"PyMC MCMC hatası: {e}")
            return self._failed_result(target_id, sector, str(e))

        # ── Sonuçları çıkar ──
        logger.info("Posterior analizi yapılıyor...")

        param_names = [
            "period", "t0", "rp_rs", "impact_parameter",
            "u1", "u2", "log_jitter", "baseline",
        ]

        posteriors = {}
        for pname in param_names:
            summary = self._extract_posterior_summary(idata, pname)
            if summary is not None:
                posteriors[pname] = summary

        # Yakınsama kontrolü
        r_hat_values = [
            p.r_hat for p in posteriors.values()
            if np.isfinite(p.r_hat)
        ]
        r_hat_max = max(r_hat_values) if r_hat_values else 99.0
        convergence_ok = r_hat_max < 1.1

        # Iraksama sayısı
        try:
            n_divergences = int(
                idata.sample_stats.diverging.values.sum()
            )
        except Exception:
            n_divergences = -1

        # Medyan değerleri çıkar
        def get_median(pname: str) -> float:
            if pname in posteriors:
                return posteriors[pname].median
            return 0.0

        def get_std(pname: str) -> float:
            if pname in posteriors:
                return posteriors[pname].std
            return 0.0

        period_median = get_median("period")
        rp_rs_median = get_median("rp_rs")
        b_median = get_median("impact_parameter")
        u1_median = get_median("u1")
        u2_median = get_median("u2")

        # Yörünge eğimi
        from astrotransit.modeling.transit_model import TransitModel
        a_over_rs = TransitModel.compute_a_over_rs(
            period_median, stellar_mass, stellar_radius
        )
        inclination = TransitModel.impact_to_inclination(b_median, a_over_rs)

        # Türetilmiş parametreler
        derived = compute_derived_parameters(
            period=period_median,
            rp_rs=rp_rs_median,
            impact_parameter=b_median,
            duration=priors.duration,
            stellar_radius=stellar_radius,
            stellar_mass=stellar_mass,
            stellar_teff=stellar_teff,
        )

        n_samples = self.draws * self.chains

        result = MCMCFitResult(
            target_id=target_id,
            sector=sector,
            success=True,
            posteriors=posteriors,
            period=period_median,
            period_err=get_std("period"),
            t0=get_median("t0"),
            rp_rs=rp_rs_median,
            rp_rs_err=get_std("rp_rs"),
            impact_parameter=b_median,
            inclination=float(inclination),
            u1=u1_median,
            u2=u2_median,
            log_likelihood=float(-np.inf),
            r_hat_max=float(r_hat_max),
            n_divergences=n_divergences,
            n_samples=n_samples,
            derived=derived,
            convergence_ok=convergence_ok,
        )

        if convergence_ok:
            logger.info(
                f"MCMC BAŞARILI — "
                f"{target_id} sektör {sector}: "
                f"P={result.period:.4f}±{result.period_err:.4f}d, "
                f"Rp/Rs={result.rp_rs:.4f}±{result.rp_rs_err:.4f}, "
                f"Rp={result.derived.planet_radius_rearth:.2f} Re, "
                f"R-hat_max={r_hat_max:.3f}, "
                f"ıraksama={n_divergences}"
            )
        else:
            logger.warning(
                f"MCMC YAKINSAMA SORUNU — "
                f"{target_id} sektör {sector}: "
                f"R-hat_max={r_hat_max:.3f} > 1.1"
            )

        return result

    def _failed_result(
        self,
        target_id: str,
        sector: int,
        reason: str = "",
    ) -> MCMCFitResult:
        """Başarısız MCMC sonucu döndürür."""

        return MCMCFitResult(
            target_id=target_id,
            sector=sector,
            success=False,
            convergence_ok=False,
            fit_method="mcmc",
        )