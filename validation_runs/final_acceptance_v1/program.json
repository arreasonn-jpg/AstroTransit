{
  "schema_version": "1.1",
  "program": "final_acceptance_v1",
  "status": "in_progress",
  "claim_policy": "A gate closes only when its declared status and immutable evidence are measured/pass and every predeclared acceptance check passes; pending work is never a score.",
  "gates": [
