        {"path": "campaign", "operator": "equals", "value": "fpp_quality_calibration_v1"},
        {"path": "cohorts.frozen_selection.detector_used_for_selection", "operator": "equals", "value": false},
        {"path": "cohorts.frozen_selection.cohort_sha256", "operator": "equals", "value": "9de7d31a0aaf45418f849c733de975e9b498a75b579390999674ca08ebe4ab2c"},
        {"path": "recorded_rows", "operator": "gte", "value": 200},
        {"path": "cohorts.false_positives.fpp_available_count", "operator": "gte", "value": 60},
        {"path": "cohorts.planets.fpp_available_count", "operator": "gte", "value": 60},
        {"path": "cases.n_cases", "operator": "gte", "value": 120},
        {"path": "splits.blind_test.n_cases", "operator": "gte", "value": 10},
        {"path": "splits.blind_test.roc_auc", "operator": "gte", "value": 0.6},
        {"path": "data_integrity.zero_filled_missing_fpp_count", "operator": "equals", "value": 0},
        {"path": "data_integrity.duplicate_target_ids", "operator": "equals", "value": 0},
        {"path": "method.calibration_transform_applied", "operator": "equals", "value": false}
      ]
    },
    {"id": "detrending_cadence_impact_robustness", "status": "pending_run", "required_output": "validation_runs/final_acceptance_v1/robustness/report.json"},
    {"id": "tls_bls_baselines_ablations", "status": "pending_run", "required_output": "validation_runs/final_acceptance_v1/baselines/report.json"},
    {
      "id": "blind_domain_holdout",
      "status": "pending_run",
      "required_output": "validation_runs/final_acceptance_v1/blind_holdout/report.json",
      "input_contract": "validation_runs/final_acceptance_v1/blind_holdout/holdout_manifest.json",
      "runner": "scripts/validation/run_blind_holdout.py",
      "rationale": "The corpus is frozen offline from committed label sources: 144 real targets drawn only from the blind partition, disjoint from every prior gate id, selected without consulting the detector. The floors are qualification floors declared before any measurement (recall >= 0.5 on published confirmed planets, false-positive rate <= 0.6 on disposition-labelled false positives, zero unevaluated targets). Only the run is missing: the report is written where light curves can be fetched, and a missing row keeps the gate open rather than silently shrinking the denominator.",
      "acceptance_checks": [
        {"path": "status", "operator": "equals", "value": "measured"},
        {"path": "campaign", "operator": "equals", "value": "blind_domain_holdout_v1"},
        {"path": "corpus.sha256", "operator": "equals", "value": "3fd1e65a2ddc15d37c624571a5f39d7bdeae724609d427d7dfbc2e1320a0b1d2"},
        {"path": "corpus.n_cases", "operator": "gte", "value": 144},
        {"path": "corpus.counts.planet", "operator": "gte", "value": 60},
        {"path": "corpus.counts.false_positive", "operator": "gte", "value": 60},
        {"path": "data.n_evaluated", "operator": "gte", "value": 120},
        {"path": "data.errors", "operator": "equals", "value": 0},
        {"path": "disjointness.non_blind_rows", "operator": "equals", "value": 0},
        {"path": "disjointness.excluded_id_count", "operator": "gte", "value": 100},
        {"path": "method.detector_used_for_selection", "operator": "equals", "value": false},
        {"path": "method.retrained", "operator": "equals", "value": false},
        {"path": "method.data", "operator": "equals", "value": "real_light_curves"},
        {"path": "method.declared_floor_recall", "operator": "equals", "value": 0.5},
        {"path": "method.declared_ceiling_false_positive_rate", "operator": "equals", "value": 0.6},
        {"path": "overall.recall", "operator": "gte", "value": 0.5},
        {"path": "overall.false_positive_rate", "operator": "lte", "value": 0.6},
        {"path": "strata.planet:CP.n_evaluated", "operator": "gte", "value": 8},
        {"path": "strata.planet:KP.n_evaluated", "operator": "gte", "value": 8},
        {"path": "strata.false_positive:FP.n_evaluated", "operator": "gte", "value": 8},
        {"path": "strata.false_positive:APC.n_evaluated", "operator": "gte", "value": 8},
        {"path": "strata.false_positive:FA.n_evaluated", "operator": "gte", "value": 8}
      ]
    },
