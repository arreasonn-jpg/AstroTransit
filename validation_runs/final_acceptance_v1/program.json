      "status": "pending_run",
      "required_output": "validation_runs/final_acceptance_v1/adversarial_fp/report.json",
      "input_contract": "validation_runs/final_acceptance_v1/adversarial_fp/corpus_manifest.json",
      "runner": "scripts/validation/run_adversarial_fp_controls.py",
      "rationale": "Floors declared before the frozen-grid measurement: a vetting layer that cannot reject the six declared adversarial morphologies in at least 80% of cases (50% per family) is not qualified, and the planetary_control floor exists so that blanket rejection cannot score as success. The corpus is synthetic, so this gate needs a run, not external data; failing the floors keeps the gate open with the numbers published.",
      "acceptance_checks": [
        {"path": "status", "operator": "equals", "value": "measured"},
        {"path": "campaign", "operator": "equals", "value": "adversarial_false_positives_v1"},
        {"path": "corpus.grid_sha256", "operator": "equals", "value": "2e2b434d5d609883c3f3803dd24950f595a1482e523e8bf71d04d214bd4ace20"},
        {"path": "corpus.n_scenarios", "operator": "gte", "value": 56},
        {"path": "corpus.n_families", "operator": "gte", "value": 7},
        {"path": "overall.adversarial_rejection_rate", "operator": "gte", "value": 0.8},
        {"path": "overall.control_acceptance_rate", "operator": "gte", "value": 0.5},
        {"path": "overall.total_errors", "operator": "equals", "value": 0},
        {"path": "families.blended_diluted_eb.rejection_rate", "operator": "gte", "value": 0.5},
        {"path": "families.eb_with_secondary_eclipse.rejection_rate", "operator": "gte", "value": 0.5},
        {"path": "families.eclipsing_binary_v.rejection_rate", "operator": "gte", "value": 0.5},
        {"path": "families.grazing_eclipsing_binary.rejection_rate", "operator": "gte", "value": 0.5},
        {"path": "families.odd_even_alternating_eb.rejection_rate", "operator": "gte", "value": 0.5},
        {"path": "families.spot_modulated_dip.rejection_rate", "operator": "gte", "value": 0.5},
        {"path": "method.data", "operator": "equals", "value": "synthetic"},
        {"path": "method.declared_floor_rejection_rate", "operator": "equals", "value": 0.8},
        {"path": "method.declared_floor_control_acceptance", "operator": "equals", "value": 0.5},
        {"path": "method.declared_floor_per_family_rejection_rate", "operator": "equals", "value": 0.5},
        {"path": "method.fpp_reject_threshold", "operator": "equals", "value": 0.5},
        {"path": "method.missing_fpp_treatment", "operator": "equals", "value": "None is never read as zero risk"}
      ]
    },
    {
      "id": "fpp_quality_calibration",
      "status": "pending_run",
