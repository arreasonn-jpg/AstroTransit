        {"path": "method.bootstrap_unit", "operator": "equals", "value": "host_id"},
        {"path": "method.bootstrap_replicates", "operator": "equals", "value": 10000},
        {"path": "method.bootstrap_seed", "operator": "equals", "value": 42},
        {"path": "uncertainty_coverage.status", "operator": "equals", "value": "not_evaluated_no_per_trial_intervals"}
      ]
    },
    {
      "id": "labelled_fp_quiet_controls",
      "status": "pending_run",
      "required_output": "validation_runs/final_acceptance_v1/false_positive_controls/report.json",
